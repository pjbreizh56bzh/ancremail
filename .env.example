# ─── Application ───────────────────────────────────────────────
# URL publique de l'app (sert à la vérification d'origine anti-CSRF et aux liens).
APP_URL="http://localhost:3000"
# Base PostgreSQL
DATABASE_URL="postgresql://ancre:ancre_dev_pw@localhost:5432/ancremail?schema=public"

# ─── Email ─────────────────────────────────────────────────────
# Domaine des adresses créées (ex: agents.mondomaine.fr). Les MX doivent pointer vers le fournisseur.
MAIL_DOMAIN="agents.localhost"
# Fournisseur : "mock" (dev/tests, aucun envoi réel) ou "mailgun"
MAIL_PROVIDER="mock"
MAILGUN_API_KEY=""
MAILGUN_BASE_URL="https://api.eu.mailgun.net"
MAILGUN_WEBHOOK_SIGNING_KEY=""
# Secret HMAC pour le webhook entrant générique (fournisseur "mock"). 32+ caractères aléatoires.
INBOUND_WEBHOOK_SECRET="change-me-with-openssl-rand-hex-32-xxxxxxxx"

# ─── Paiement Stripe (MODE TEST) ───────────────────────────────
STRIPE_SECRET_KEY=""            # sk_test_...
STRIPE_WEBHOOK_SECRET=""        # whsec_...
STRIPE_PRICE_PRO=""             # price_... (abonnement mensuel Pro)
STRIPE_PRICE_SCALE=""           # price_... (abonnement mensuel Scale)
# Garde-fou : les clés sk_live_ sont refusées tant que ceci n'est pas "true".
ALLOW_LIVE_PAYMENTS="false"
